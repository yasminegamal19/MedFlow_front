# index.html must always be revalidated so a new deploy is visible
# immediately — LiteSpeed's page cache otherwise serves a stale copy
# referencing old (deleted) hashed asset filenames until it expires.
<IfModule LiteSpeed>
  CacheLookup public off
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed filenames (index-<hash>.js/css) are safe to cache forever —
  # a new build always gets new filenames.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
