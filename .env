# Where the React app sends API calls. Default is a relative path that the Vite
# dev server proxies to the Laravel backend (see vite.config.js), which avoids
# CORS entirely in development.
VITE_API_BASE=/api

# The Laravel backend origin the Vite dev server proxies /api to.
VITE_BACKEND_ORIGIN=http://localhost:8080

