# Where the React app sends API calls. Default is a relative path that the Vite
# dev server proxies to the Laravel backend (see vite.config.js), which avoids
# CORS entirely in development.
VITE_API_BASE=http://localhost:8010/api

# The Laravel backend origin the Vite dev server proxies /api to.
VITE_BACKEND_ORIGIN=http://localhost:8010

# Sanctum bearer token for the seeded local dev user (dev@medflow.local).
# Only /api/v1/ai/* requires this. Re-mint if the DB is reseeded:
#   php artisan tinker --execute="echo \App\Domain\Organization\Models\User::where('email','dev@medflow.local')->first()->createToken('dev')->plainTextToken;"
VITE_API_TOKEN=18|qqDCM3nwgQxTCfIvVeYVwfXZw1sbE6NiLa15Cm4P70531982
